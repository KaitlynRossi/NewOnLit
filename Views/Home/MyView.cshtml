@model IEnumerable<ASPProject.Models.Book>

<!DOCTYPE html>
<html>
<head>
    <title>Book List</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
    html, body {
        height: 100vh;
        background: url('../images/BackgroundForest.jpg') no-repeat center center;
        background-size: cover;
        background-attachment: fixed;
        overflow-x: hidden;
    }

        .fantasy-heading {
        font-family: 'Rouge Script', cursive;
        font-size: 3rem;
        color: #1e2a38;
        font-size: 60px;
        text-align: center;
        text-shadow:
            0 0 8px #f8e7c9,
            0 0 16px #fceabb,
            0 0 24px #f9d29d;
        padding: 0.5rem 1.5rem;
        border-radius: 1rem;
        display: inline-block;
        margin: 2rem auto;
        position: relative;
        animation: glowPulse 3s ease-in-out infinite;
    }

    @@keyframes glowPulse {
        0%, 100% {
            text-shadow:
                0 0 8px #f8e7c9,
                0 0 16px #fceabb,
                0 0 24px #f9d29d;
        }
        50% {
            text-shadow:
                0 0 12px #fff1cc,
                0 0 24px #ffe7a1,
                0 0 36px #ffd580;
        }
    }


    .fantasy-heading::before, 
    .fantasy-heading::after {
        content: '✨';
        position: absolute;
        font-size: 1.2rem;
        animation: sparkle 2.5s infinite ease-in-out;
        opacity: 0.7;
    }

    .fantasy-heading::before {
        top: -10px;
        left: 10%;
        animation-delay: 0s;
    }

    .fantasy-heading::after {
        bottom: -10px;
        right: 15%;
        animation-delay: 1.25s;
    }

    @@keyframes sparkle {
        0%   { transform: translateY(0) scale(1); opacity: 0.7; }
        50%  { transform: translateY(-10px) scale(1.3); opacity: 1; }
        100% { transform: translateY(0) scale(1); opacity: 0.7; }
    }


    .fantasy-card {
        background: #1e2a38;
        border: 1px solid #1a252f;
        color: #ecf0f1; 
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5); 
        position: relative;
        overflow: hidden;
        font-family: 'Klee One';
    }

    .fantasy-card:hover {
        box-shadow: 0 0 25px #ffe7a1; 
    }

    .card-img-top {
        width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 0.75rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card-img-top:hover {
        transform: scale(1.03);
    }

    .card-body {
        padding: 1rem;
        position: relative;
        z-index: 1;
    }

    .dark-card {
        background-color: #1e2a38;
        color: #fff;
        font-family: 'Klee One';
    }

    .dark-card .form-control {
        background-color: #1e2a38;
        border: 1px solid #4c5c70;
        color: #fff;
    }

    .dark-card .form-control::placeholder {
        color: #ccc;
    }


    .custom-mt {
        margin-top: 4rem;
    }
</style>
</head>
<body>

    <div class="container custom-mt">
         <div class="d-flex justify-content-center">
            <h1 class="fantasy-heading">Available Books</h1>
        </div>
        <form action="/Home/MyView" method="get" class="mb-4 p-3 rounded dark-card">
            <div class="row g-2 align-items-end">
                <div class="col">
                    <label for="search" class="form-label">Search:</label>
                    <input type="text" id="search" name="search" class="form-control text-light bg-transparent border-light" placeholder="Search for books...">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-light">Go</button>
                </div>
            </div>
        </form>

        <div class="row">
            @foreach (var book in Model)
            {
                <div class="col-md-3 d-flex align-items-stretch">
                    <div class="card fantasy-card text-center mb-4 p-3 w-100">
                        <img src="@book.ImageUrl" class="card-img-top mx-auto" alt="Book Cover" style="width: 200px; height: 300px;" />
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h5 class="card-title">@book.Title</h5>
                            <p class="card-text">Author: @book.Author</p>
                            <p class="card-text">Price: @book.Price.ToString("C")</p>
                            <a href="@Url.Action("Details", "Home", new { id = book.Id })" class="btn btn-outline-light mt-2">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
