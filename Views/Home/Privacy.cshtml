@{
    ViewData["Title"] = "Community and Monetization Policy";
}

<title>Privacy</title>
  <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=MedievalSharp&display=swap" rel="stylesheet" />
  <style>
    html,
    body {
      margin: 0;
      padding: 0;
      height: 100vh;
      background: url('../images/BackgroundForest.jpg') no-repeat center center fixed;
      background-size: cover;
      font-family: 'MedievalSharp', cursive;
    }

    .formCard {
      backdrop-filter: blur(6px);
      background-color: rgba(0, 0, 0, 0.4);
      border-radius: 20px;
      color: white;
      width: 95%;
      max-width: 1000px;
      padding: 2rem;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.37);
      margin: auto;
      margin-bottom: 5%;
      margin-top: 5%;
    }

    .Privacy-h1 {
      font-size: 3rem;
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .Privacy-txt p {
      font-size: 1.1rem;
      line-height: 1.6;
      margin-bottom: 1rem;
    }
  </style>
  <body>
    <section style="padding-top: 5%;">
        <div class="formCard">
             <h1 class="Privacy-h1">@ViewData["Title"]</h1>
                 <p class="Privacy-txt">OnLit is focused on offering users a quality service and a safe space platform to share opinions on novels. To protect the community aspect of our service OnLit may remove posts made and temporarily restrict a user’s communicative features for inappropriate content in reviews. Inappropriate content, as defined by this policy, is any content deemed as harassment, hate speech, overly vulgar, misinformation, . OnLit seeks to offer users a space to discuss a number of novels, including those with sensitive or graphic content. Our aim with the community policy is to keep reviews relevant and appropriate to the books. Any creators to partner with OnLit will be offered a majority portion of the monetization of novels. Individual partnership contracts vary.  
    </p>
        </div>
    </section>
  </body>

