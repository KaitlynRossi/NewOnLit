@model ASPProject.Models.Customer

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Welcome</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=MedievalSharp&display=swap" rel="stylesheet" />
    <style>
        .WelcomeCard {
            backdrop-filter: blur(6px);
            background-color: rgba(0, 0, 0, 0.4);
            border-radius: 20px;
            color: white;
            max-width: 600px;
            width: 90%;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            text-align: center;
            margin: auto;
            padding: 2rem;
            min-height: 300px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }


        h2 {
            font-family: 'MedievalSharp', cursive;
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        p {
            font-size: 1.2rem;
            margin: 0.5rem 0;
        }

        .btn-custom {
            background-color: #9ab39a;
            border: none;
            color: white;
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            margin-top: 1.5rem;
            border-radius: 8px;
            transition: background-color 0.3s ease;
        }

        .btn-custom:hover {
            color: white;
            background-color: #879a87;
        }
    </style>
</head>
<section>
<body style="background: url('/images/BackgroundForest.jpg') no-repeat center center fixed; background-size: cover;">
    <section style="height: 100vh">
        <div class="WelcomeCard">
            <h2>Welcome to OnLit</h2>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Username:</strong> @Model.UserName</p>
            <a class="btn btn-custom" asp-controller="Home" asp-action="MyView">Go to Bookstore</a>
        </div>
        <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    </section>
</body>

</html>