@model ASPProject.Models.Customer
@{
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>

<head>
  <meta name="viewport" content="width=device-width" />
  <title>CreateAccount</title>
  <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.css" />
  <link href="https://fonts.googleapis.com/css2?family=MedievalSharp&display=swap" rel="stylesheet" />
  <style>
    input.form-control {
      background-color: rgba(255, 255, 255, 0.15);
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    input.form-control::placeholder {
      color: rgba(255, 255, 255, 0.7);
    }

    input.form-control:focus {
      background-color: rgba(255, 255, 255, 0.25);
      box-shadow: none;
      color: white;
    }


    html,
    body {
      margin: 0;
      padding: 0;
      height: 100vh;
      background: url('../images/BackgroundForest.jpg') no-repeat center center;
      background-size: cover;
      background-attachment: fixed;
      overflow-x: hidden;
      box-sizing: border-box;
    }

    .custom-btn {
      margin-left: -4.5%;
      background-color: #889e88;
      padding: 10px 15px;
      border-radius: 25px;
      text-decoration: none;
      font-family: 'Klee One';
      color: black;
      transition: all 0.3s ease;
      display: inline-block;
      white-space: nowrap;
    }

    .custom-btn {
      margin-left: -4.5%;
      background-color: #889e88;
      padding: 10px 15px;
      border-radius: 25px;
      text-decoration: none;
      font-family: 'Klee One';
      color: black;
      transition: all 0.3s ease;
      display: inline-block;
      white-space: nowrap;
    }
  </style>
</head>

<body>

  <div class="text-center pt-5">
    <h1
      style="font-family: 'MedievalSharp', cursive; color: white; font-size: 3rem; margin-bottom:-80px;margin-top:160px;">
      Create An Account
    </h1>
  </div>

  <div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card bg-transparent border-0 text-white shadow" style="
            width: 100%;
            max-width: 500px;
            backdrop-filter: blur(10px);
            background-color: rgba(0, 0, 0, 0.25);
            border-radius: 12px;
        ">
      <div class="card-body">
        <form asp-action="CreateAccount" method="post">
          <div asp-validation-summary="All" class="text-danger"></div>

          <div class="form-group mb-3">
            <label asp-for="Email"></label>
            <input class="form-control" asp-for="Email" required />
          </div>

          <div class="form-group mb-3">
            <label asp-for="UserName"></label>
            <input class="form-control" asp-for="UserName" required />
          </div>

          <div class="form-group mb-4">
            <label asp-for="Password"></label>
            <input type="password" class="form-control" asp-for="Password" required />
          </div>

          <div style="display:flex;justify-content:center;gap:2rem;margin-left:35px;">
            <button class="custom-btn" type="submit" style="background:#9ab39a;">
              Create Account
            </button>
            <a class="custom-btn" href="@Url.Action("Login", "Customer")" style="background:#9ab39a;">
              Login to Account
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>

</html>
