@model List<ASPProject.Models.ShoppingCart>
<!DOCTYPE html>
<html>
    <head>
        <title>Shopping Cart</title>
        <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        <style>
            body{
                height: 100vh;
                background: url('../images/BackgroundForest.jpg') no-repeat center center;
                background-size: cover;
                background-attachment: fixed;
                overflow-x: hidden;
            }
        .fantasy-heading {
            font-family: 'Rouge Script', cursive;
            font-size: 3rem;
            color: #1e2a38;
            font-size: 60px;
            text-align: center;
            text-shadow:
                0 0 8px #f8e7c9,
                0 0 16px #fceabb,
                0 0 24px #f9d29d;
            padding: 0.5rem 1.5rem;
            border-radius: 1rem;
            display: inline-block;
            margin: 2rem auto;
            position: relative;
            animation: glowPulse 3s ease-in-out infinite;
        }

        @@keyframes glowPulse {
            0%, 100% {
                text-shadow:
                    0 0 8px #f8e7c9,
                    0 0 16px #fceabb,
                    0 0 24px #f9d29d;
            }
            50% {
                text-shadow:
                    0 0 12px #fff1cc,
                    0 0 24px #ffe7a1,
                    0 0 36px #ffd580;
            }
        }


        .fantasy-heading::before, 
        .fantasy-heading::after {
            content: '✨';
            position: absolute;
            font-size: 1.2rem;
            animation: sparkle 2.5s infinite ease-in-out;
            opacity: 0.7;
        }

        .fantasy-heading::before {
            top: -10px;
            left: 10%;
            animation-delay: 0s;
        }

        .fantasy-heading::after {
            bottom: -10px;
            right: 15%;
            animation-delay: 1.25s;
        }

        @@keyframes sparkle {
            0%   { transform: translateY(0) scale(1); opacity: 0.7; }
            50%  { transform: translateY(-10px) scale(1.3); opacity: 1; }
            100% { transform: translateY(0) scale(1); opacity: 0.7; }
        }

        .fantasy-card {
        background: #1e2a38;
        border: 1px solid #1a252f;
        color: #ecf0f1; 
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5); 
        position: relative;
        overflow: hidden;
        font-family: 'Klee One';
        }

        .card-img-top {
        width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 0.75rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card-img-top:hover {
            transform: scale(1.03);
        }

        .fantasy-card:hover {
            box-shadow: 0 0 25px #ffe7a1; 
        }

        .custom-mt{
            margin-top: 6rem;
        }
        </style>
    </head>
    <body style="background-color: #9ab39a;">
        <div class="container">
            <div class="d-flex justify-content-center">
                <h1 class="fantasy-heading custom-mt">Your Shopping Cart</h1>
            </div>

            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card fantasy-card text-center mb-4 p-3 w-100">

                            <img src="@item.Book.ImageUrl" class="card-img-top mx-auto" alt="Book Cover" style="width: 200px; height: 300px;" />
                            
                            <div class="card-body d-flex flex-column justify-content-between">
                                <h5 class="card-title">@item.Book.Title</h5>
                                <p class="card-text">Author: @item.Book.Author</p>
                                <p class="card-text">Price: $@item.Book.Price</p>
                                <p class="card-text">Quantity: @item.Quantity</p>
                                
                                <!-- Delete Button -->
                                <form action="@Url.Action("RemoveFromCart", "ShoppingCart", new { bookId = item.BookId })" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-4">
                <form action="@Url.Action("MyView", "Home")" method="get">
                    <button type="submit" class="btn" style="background-color: #889e88; margin-bottom: 10px;">Continue Shopping</button>
                </form>
                <!-- Checkout Button -->
                <form action="@Url.Action("Checkout", "ShoppingCart")" method="get">
                    <button type="submit" class="btn" style="background-color: #889e88; margin-bottom: 10px;">Proceed to Checkout</button>
                </form>
            </div>

        </div>
    </body>
</html>
