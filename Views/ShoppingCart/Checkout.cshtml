@model CheckoutViewModel
<html>
    <head>
        <title>Checkout</title>
        <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" />
        <link href="https://fonts.googleapis.com/css2?family=MedievalSharp&display=swap" rel="stylesheet" />

        <style>
    html, body{
      margin: 0;
      padding: 0;
      height: 100vh;
      background: url('../images/BackgroundForest.jpg') no-repeat center center fixed;
      background-size: cover;
    }

    .fantasy-heading {
        font-family: 'Rouge Script', cursive;
        font-size: 3rem;
        color: #1e2a38;
        font-size: 60px;
        text-align: center;
        text-shadow:
            0 0 8px #f8e7c9,
            0 0 16px #fceabb,
            0 0 24px #f9d29d;
        padding-top: 4rem;
        border-radius: 1rem;
        display: inline-block;
        margin: 2rem auto;
        position: relative;
        animation: glowPulse 3s ease-in-out infinite;
    }
    .font{
        font-family: 'Klee One';
        display: grid;
        grid-template-columns: auto auto auto;
        column-gap: 50px;
        color: white;
    }
    .custom-button {
        background-color: #889e88;
        color: white;
        border: none;
    }
    
    .btn:hover {
        opacity: 0.9;
    }

    .payInfo{
      backdrop-filter: blur(6px);
      background-color: rgba(0, 0, 0, 0.4);
      column-span: 2;
      border-radius: 20px;
      color: white;
      width: 125%;
      max-width: 1000px;
      padding: 2rem;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.37);
      margin: auto;
      margin-bottom: 5%;
      margin-top: 5%;
    }

    .orderSummary {
      column-span: 1;
      backdrop-filter: blur(6px);
      background-color: rgba(0, 0, 0, 0.4);
      border-radius: 20px;
      color: white;
      width: 75%;
      max-width: 500px;
      padding: 2rem;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.37);
      margin: auto;
    }
    .center{
        display: flex;
        justify-content: center;
        width:100%;
    }

    .custom-input {
        border: 1px solid #ced4da;
        background-color: rgba(0, 0, 0, 0.4);
        border-radius: 8px; 
        color: white
        padding: 0.5rem; 
    }

    .custom-input:focus {
        color: white;
        border-color: #889e88;
        box-shadow: 0 0 0 0.2rem rgba(136, 158, 136, 0.25);
        outline: 0;
        background-color: rgba(0, 0, 0, 0.6); /* Slightly darker when focused */
    }
</style>
  </head>
    <body>
        <div class="center">
            <h1 class="text-center fantasy-heading" >Checkout</h1>
         </div>
        <div class="container mt-3 font">
            <div class="orderSummary">
                <h3>Order Summary</h3>
                <table class="table" style="color:white">
                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td>@item.Book.Title</td>
                                <td>@item.Book.Price.ToString("C")</td>
                                <td>@item.Quantity</td>
                                <td>$@(item.Book.Price * item.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <p><strong>Subtotal:</strong> @Model.Total.ToString("C")</p>
                <p><strong>Tax:</strong> @Model.Tax.ToString("C")</p>
                <p><strong>Shipping:</strong> @Model.Shipping.ToString("C")</p>
                <p><strong>Grand Total:</strong> @Model.GrandTotal.ToString("C")</p>
            </div>

            <div class="payInfo">
                <h3>Payment Information</h3>
                <form asp-action="Checkout" method="post">
                    <div class="form-group mb-3">
                        <label for="FullName">Full Name</label>
                        <input type="text" id="FullName" name="FullName" class="form-control custom-input" required />
                    </div>
                    <div class="form-group mb-3">
                        <label for="Email">Email</label>
                        <input type="text" id="Email" name="Email" class="form-control custom-input" required />
                    </div>
                    <div class="form-group mb-3">
                        <label for="CreditCardNumber">Credit Card Number</label>
                        <input type="text" id="CreditCardNumber" name="CreditCardNumber" class="form-control custom-input" required />
                    </div>
                    <div class="form-group mb-3">
                        <label for="ExpirationDate">Expiration Date</label>
                        <input type="text" id="ExpirationDate" name="ExpirationDate" class="form-control custom-input" placeholder="MM/YY" required />
                    </div>
                    <div class="form-group mb-3">
                        <label for="CVV">CVV</label>
                        <input type="text" id="CVV" name="CVV" class="form-control custom-input" required />
                    </div>
                     <div class="center">
                        <a href="@Url.Action("OrderConfirmation", "ShoppingCart")" class="btn custom-button">Confirm Order</a>
                    </div>
                </form>
            </div>
        </div>
    </body>
</html>
